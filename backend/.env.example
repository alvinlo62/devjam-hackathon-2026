GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173

# 如果組織的 GCP 安全政策禁用 API key（例如賽事方發的帳號只給
# Application Default Credentials），改用這三個變數，GEMINI_API_KEY
# 留空即可；本機要先跑過官方的 setup_adc.sh 產生憑證：
# bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Cloud SQL（PostgreSQL）。本機開發不需要填，留空時 db/cloudsql/client.py 完全不會被呼叫。
# 正式環境走 Secret Manager 的單一 JSON secret（見 workflow 裡的 CLOUD_SQL_CONFIG）。
CLOUD_SQL_CONFIG='{
    "instance_connection_name":"your_project:asia-east1:your_instance",
    "db_name":"your_db_name",
    "db_user":"your_db_user",
    "db_password":"your_db_password"
}'
