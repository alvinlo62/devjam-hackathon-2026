GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173

# Cloud SQL（PostgreSQL）。本機開發不需要填，留空時 db/cloudsql/client.py 完全不會被呼叫。
# 正式環境走 Secret Manager 的單一 JSON secret（見 workflow 裡的 CLOUD_SQL_CONFIG）。
CLOUD_SQL_CONFIG='{
    "instance_connection_name":"your_project:asia-east1:your_instance",
    "db_name":"your_db_name",
    "db_user":"your_db_user",
    "db_password":"your_db_password"
}'
